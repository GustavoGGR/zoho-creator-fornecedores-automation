/* Verifica se o CNPJ digitado possui 14 dígitos */
if(input.cnpj.length() == 14)
{
	respostaCNPJ = invokeurl
	[
		url :"https://brasilapi.com.br/api/cnpj/v1/" + input.cnpj
		type :GET
	];
	input.razao_social = ifnull(respostaCNPJ.get("razao_social"),"");
	input.nome_fantasia = ifnull(respostaCNPJ.get("nome_fantasia"),"");
	situacao = ifnull(respostaCNPJ.get("descricao_situacao_cadastral"),"");
	if(situacao == "ATIVA")
	{
		input.situacao_cadastral = "Ativa";
	}
	else if(situacao == "BAIXADA")
	{
		input.situacao_cadastral = "Baixada";
	}
	else if(situacao == "SUSPENSA")
	{
		input.situacao_cadastral = "Suspensa";
	}
	else if(situacao == "INAPTA")
	{
		input.situacao_cadastral = "Inapta";
	}
	else if(situacao == "NULA")
	{
		input.situacao_cadastral = "Nula";
	}
	cepAPI = ifnull(respostaCNPJ.get("cep"),"");
	if(cepAPI != "")
	{
		input.cep = cepAPI;
	}
}
else
{
	alert "O CNPJ deve conter 14 dígitos.";
}
