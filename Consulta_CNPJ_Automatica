cnpj_limpo = input.Cnpj.replaceAll("[^0-9]","");
if(cnpj_limpo == "")
{
	return;
}
if(cnpj_limpo.length() != 14)
{
	alert "O CNPJ deve conter 14 dígitos numéricos.";
	return;
}
try 
{
	url_cnpj = "https://brasilapi.com.br/api/cnpj/v1/" + cnpj_limpo;
	resp = invokeurl
	[
		url :url_cnpj
		type :GET
	];
	// LOG DE SUCESSO
	thisapp.fn_log_consulta("CNPJ",cnpj_limpo,"Sucesso",resp.toString());
	// PREENCHIMENTO AUTOMÁTICO
	input.Razao_Social = ifnull(resp.get("razao_social"),"");
	input.Nome_Fantasia = ifnull(resp.get("nome_fantasia"),"");
	input.Situacao_Cadastral = ifnull(resp.get("descricao_situacao_cadastral"),"");
	// CEP AUTOMÁTICO
	cep_api = ifnull(resp.get("cep"),"");
	if(cep_api != "")
	{
		cep_limpo = cep_api.replaceAll("[^0-9]","");
		input.Cep = cep_limpo;
	}
}
catch (e)
{
	// LOG DE ERRO
	thisapp.fn_log_consulta("CNPJ",cnpj_limpo,"Erro",e.toString());
	alert "Não foi possível consultar o CNPJ. Tente novamente.";
}
