/* Verifica se o CEP digitado possui 8 dígitos */
if(input.cep.length() == 8)
{
	/* Consulta a BrasilAPI usando o CEP informado */
	respostaCEP = invokeurl
	[
		url :"https://brasilapi.com.br/api/cep/v2/" + input.cep
		type :GET
	];
	/* Preenche o campo Logradouro com o valor retornado pela API */
	input.logradouro = ifnull(respostaCEP.get("street"),"");
	/* Preenche o campo Bairro com o valor retornado pela API */
	input.bairro = ifnull(respostaCEP.get("neighborhood"),"");
	/* Preenche o campo Cidade com o valor retornado pela API */
	input.cidade = ifnull(respostaCEP.get("city"),"");
	/* Captura a UF retornada pela API */
	ufAPI = ifnull(respostaCEP.get("state"),"");
	/* Preenche o campo UF com o valor retornado */
	if(ufAPI != "")
	{
		input.uf = ufAPI;
	}
}
else
{
	/* Exibe mensagem se o CEP não tiver 8 dígitos */
	alert "O CEP deve conter 8 dígitos.";
}
