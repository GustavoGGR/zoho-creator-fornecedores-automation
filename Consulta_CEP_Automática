// Limpa o CEP: se for nulo vira "" e remove qualquer caractere que não seja número
cepLimpo = ifnull(input.cep,"").replaceAll("[^0-9]","");

// Validação: verifica se o CEP está vazio ou não tem exatamente 8 dígitos
if(cepLimpo.isEmpty() || cepLimpo.length() != 8)
{
	// Exibe mensagem para o usuário corrigir o CEP
	alert "Digite um CEP válido com 8 números.";
}
else
{
	try 
	{
		// Faz a chamada para a BrasilAPI passando o CEP
		resp = invokeurl
		[
			url :"https://brasilapi.com.br/api/cep/v2/" + cepLimpo
			type :GET
		];

		// Verifica se a API não retornou dados (CEP não encontrado)
		if(resp == null || resp.isEmpty())
		{
			// Permite que o usuário preencha manualmente
			alert "CEP não encontrado. Preencha o endereço manualmente.";
		}
		else
		{
			// Preenche o campo Logradouro com o valor retornado (ou vazio se não existir)
			input.logradouro = ifnull(resp.get("street"),"");

			// Preenche o campo Bairro
			input.bairro = ifnull(resp.get("neighborhood"),"");

			// Preenche o campo Cidade
			input.cidade = ifnull(resp.get("city"),"");

			// Preenche o campo UF e converte para maiúsculo
			input.uf = ifnull(resp.get("state"),"").toUpperCase();
		}
	}
	catch (e)
	{
		// Captura erro (API fora do ar, timeout, etc.)
		alert "Erro ao buscar CEP. Tente novamente em instantes.";
	}
}
