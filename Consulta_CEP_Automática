// Remove tudo que não for número do CEP (ex: traços)
cep_limpo = input.Cep.replaceAll("[^0-9]","");
// Se o campo estiver vazio, não faz nada
if(cep_limpo == "")
{
	return;
}
// Valida se o CEP tem exatamente 8 dígitos
if(cep_limpo.length() != 8)
{
	alert "O CEP deve conter 8 dígitos.";
	return;
}
try 
{
	// Monta a URL da API com o CEP informado
	url_cep = "https://brasilapi.com.br/api/cep/v2/" + cep_limpo;
	// Faz a requisição HTTP para a BrasilAPI
	resp = invokeurl
	[
		url :url_cep
		type :GET
	];
	// Registra no log que a consulta foi bem-sucedida
	thisapp.fn_log_consulta("CEP",cep_limpo,"Sucesso",resp.toString());
	// Preenche os campos automaticamente com os dados retornados
	input.Logradouro = ifnull(resp.get("street"),"");
	input.Bairro = ifnull(resp.get("neighborhood"),"");
	input.Cidade = ifnull(resp.get("city"),"");
	UF = ifnull(resp.get("state"),"");
}
catch (e)
{
	// Registra no log que houve erro na consulta
	thisapp.fn_log_consulta("CEP",cep_limpo,"Erro",e.toString());
	// Mostra mensagem amigável ao usuário
	alert "CEP não encontrado. Preencha manualmente.";
}
