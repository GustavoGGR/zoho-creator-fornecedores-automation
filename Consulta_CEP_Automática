if(input.cep == null || input.cep.length() < 8)
{
    alert "Digite um CEP válido com 8 números.";
}
else
{
    try 
    {
        resp = invokeurl
        [
            url :"https://brasilapi.com.br/api/cep/v2/" + input.cep
            type :GET
        ];

        if(resp.isEmpty())
        {
            alert "CEP não encontrado. Preencha o endereço manualmente.";
        }
        else
        {
            dados = resp.toMap();

            input.logradouro = dados.get("street");
            input.bairro = dados.get("neighborhood");
            input.cidade = dados.get("city");

            estado = dados.get("state");
            input.uf = estado.toUpperCase();
        }
    }
    catch(e)
    {
        alert "Erro ao buscar CEP. Tente novamente em instantes.";
    }
}
